{
  "hosting": {
    "public": "dist/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/main",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "regex": "^/projects/(art-history-jobs|beyond-the-county-line|composable-viz-lib|federal-healthcare-data-platform|flip-the-district|leaving-academia)(/.*)?$",
        "destination": "/projects/index.html"
      }
    ],
    "headers": [
      {
        "regex": "^[^.]*$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
